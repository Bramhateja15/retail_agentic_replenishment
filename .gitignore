# ============================================================
# Virtual environment
# ============================================================

.venv/
__pycache__/
*.pyc


# ============================================================
# Data layers — never commit actual data
# ============================================================

# FreshRetailNet raw data
data/raw/freshretailnet/*

# GDELT raw data
data/raw/gdelt/*

# Keep raw directory placeholders
!data/raw/freshretailnet/.gitkeep
!data/raw/gdelt/.gitkeep

# Cleaned data
data/cleaned/*

# Processed data
data/processed/*

# Keep directory placeholders
!data/cleaned/.gitkeep
!data/processed/.gitkeep


# ============================================================
# Results — ignore generated outputs except provenance records
# ============================================================

# Metadata
results/metadata/*

# Keep directory placeholder
!results/metadata/.gitkeep

# Track provenance manifests
!results/metadata/*_manifest.json

# Validation outputs
results/validation/*

# Keep directory placeholder
!results/validation/.gitkeep

# Track all small JSON validation reports (evidence for the dissertation)
!results/validation/*.json

# Inspection outputs
results/inspection/*

# Keep directory placeholder
!results/inspection/.gitkeep

# Track all small JSON inspection reports (evidence for the dissertation)
!results/inspection/*.json


# ============================================================
# Environment secrets
# ============================================================

.env


# ============================================================
# Operating system / editor files
# ============================================================

.DS_Store
.vscode/